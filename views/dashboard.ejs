      /* ── Shop theme previews (new) ── */
      .theme-preview-candy     { background: linear-gradient(135deg,#ff9de2 0%,#ffcc44 50%,#9de2ff 100%); }
      .theme-preview-vaporwave { background: linear-gradient(135deg,#1a0033 0%,#6600cc 50%,#ff71ce 100%); }
      .theme-preview-beach     { background: linear-gradient(135deg,#87ceeb 0%,#e8d8b0 100%); }

      /* ── Accent color CSS (comes after themes so accent overrides when both active) ── */
      /* Ruby */
      [data-accent="ruby"] .tracker-btn, [data-accent="ruby"] .shop-tab.active, [data-accent="ruby"] .shop-buy-btn, [data-accent="ruby"] .shop-apply-btn.shop-active-btn { background: #dc2626; }
      [data-accent="ruby"] .tracker-btn:hover { background: #b91c1c; }
      [data-accent="ruby"] .tracker-checkbox { accent-color: #dc2626; }
      [data-accent="ruby"] .cl-goal-title { color: #dc2626 !important; }
      [data-accent="ruby"] .tracker-done-badge { color: #dc2626; }
      /* Violet */
      [data-accent="violet"] .tracker-btn, [data-accent="violet"] .shop-tab.active, [data-accent="violet"] .shop-buy-btn, [data-accent="violet"] .shop-apply-btn.shop-active-btn { background: #7c3aed; }
      [data-accent="violet"] .tracker-btn:hover { background: #6d28d9; }
      [data-accent="violet"] .tracker-checkbox { accent-color: #7c3aed; }
      [data-accent="violet"] .cl-goal-title { color: #7c3aed !important; }
      [data-accent="violet"] .tracker-done-badge { color: #7c3aed; }
      /* Tangerine */
      [data-accent="tangerine"] .tracker-btn, [data-accent="tangerine"] .shop-tab.active, [data-accent="tangerine"] .shop-buy-btn, [data-accent="tangerine"] .shop-apply-btn.shop-active-btn { background: #ea580c; }
      [data-accent="tangerine"] .tracker-btn:hover { background: #c2410c; }
      [data-accent="tangerine"] .tracker-checkbox { accent-color: #ea580c; }
      [data-accent="tangerine"] .cl-goal-title { color: #ea580c !important; }
      [data-accent="tangerine"] .tracker-done-badge { color: #ea580c; }
      /* Rose */
      [data-accent="rose"] .tracker-btn, [data-accent="rose"] .shop-tab.active, [data-accent="rose"] .shop-buy-btn, [data-accent="rose"] .shop-apply-btn.shop-active-btn { background: #e11d7a; }
      [data-accent="rose"] .tracker-btn:hover { background: #be185d; }
      [data-accent="rose"] .tracker-checkbox { accent-color: #e11d7a; }
      [data-accent="rose"] .cl-goal-title { color: #e11d7a !important; }
      [data-accent="rose"] .tracker-done-badge { color: #e11d7a; }
      /* Emerald */
      [data-accent="emerald"] .tracker-btn, [data-accent="emerald"] .shop-tab.active, [data-accent="emerald"] .shop-buy-btn, [data-accent="emerald"] .shop-apply-btn.shop-active-btn { background: #059669; }
      [data-accent="emerald"] .tracker-btn:hover { background: #047857; }
      [data-accent="emerald"] .tracker-checkbox { accent-color: #059669; }
      [data-accent="emerald"] .cl-goal-title { color: #059669 !important; }
      [data-accent="emerald"] .tracker-done-badge { color: #059669; }
      /* Sky */
      [data-accent="sky"] .tracker-btn, [data-accent="sky"] .shop-tab.active, [data-accent="sky"] .shop-buy-btn, [data-accent="sky"] .shop-apply-btn.shop-active-btn { background: #0284c7; }
      [data-accent="sky"] .tracker-btn:hover { background: #0369a1; }
      [data-accent="sky"] .tracker-checkbox { accent-color: #0284c7; }
      [data-accent="sky"] .cl-goal-title { color: #0284c7 !important; }
      [data-accent="sky"] .tracker-done-badge { color: #0284c7; }
      /* Gold */
      [data-accent="gold"] .tracker-btn, [data-accent="gold"] .shop-tab.active, [data-accent="gold"] .shop-buy-btn, [data-accent="gold"] .shop-apply-btn.shop-active-btn { background: #d97706; }
