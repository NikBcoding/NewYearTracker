<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/style.css">
    <style>
      /* ── Tracker styles ── */
      .tracker-wrap { max-width: 640px; margin: 32px auto; padding: 0 16px 64px; }
      .tracker-wrap h2 { font-size: 22px; margin-bottom: 16px; }

      .tracker-add-goal-row { display: flex; gap: 8px; margin-bottom: 24px; }
      .tracker-input { flex: 1; padding: 10px 12px; border: 1px solid #d0d7e3; border-radius: 6px; font-size: 14px; }
      .tracker-btn { padding: 10px 16px; background: #0066ff; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; white-space: nowrap; }
      .tracker-btn:hover { background: #0052cc; }
      .tracker-btn-sm { padding: 8px 14px; font-size: 15px; }
      .tracker-btn-icon { background: none; border: none; cursor: pointer; font-size: 14px; color: #999; padding: 2px 6px; border-radius: 4px; }
      .tracker-btn-icon:hover { background: #f0f0f0; color: #c00; }

      .tracker-goal { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 16px; box-shadow: 0 2px 6px rgba(0,0,0,0.04); }
      .tracker-goal-header { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
      .tracker-goal-title { font-weight: 600; font-size: 16px; flex: 1; }
      .tracker-goal-progress { font-size: 12px; color: #888; }

      .tracker-task-list { list-style: none; padding: 0; margin: 0 0 12px; }
      .tracker-task { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f0f0f0; gap: 8px; }
      .tracker-task:last-child { border-bottom: none; }
      .tracker-task-name { flex: 1; font-size: 14px; }
      .tracker-task-done .tracker-task-name { text-decoration: line-through; color: #aaa; }
      .tracker-task-actions { display: flex; align-items: center; gap: 6px; }

.tracker-done-badge { font-size: 12px; color: #22c55e; font-weight: 600; }

      /* ── Checkbox ── */
      .tracker-checkbox-label { display: flex; align-items: center; gap: 8px; cursor: pointer; flex: 1; }
      .tracker-checkbox { width: 16px; height: 16px; cursor: pointer; accent-color: #0066ff; }

      /* ── Checklist section ── */
      #checklist-section { margin-top: 32px; }
      #checklist-section h2 { font-size: 20px; margin-bottom: 16px; border-top: 1px solid #e2e8f0; padding-top: 24px; }
      .cl-goal { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 14px; box-shadow: 0 2px 6px rgba(0,0,0,0.04); }
      .cl-goal-title { font-weight: 700; font-size: 15px; margin-bottom: 10px; color: #0066ff; }
      .cl-list { list-style: none; padding: 0; margin: 0; }
      .cl-item { display: flex; align-items: center; gap: 10px; padding: 6px 0; border-bottom: 1px solid #f3f4f6; font-size: 14px; }
      .cl-item:last-child { border-bottom: none; }
      .cl-check { font-size: 16px; color: #ccc; min-width: 18px; }
      .cl-done .cl-check { color: #22c55e; }
      .cl-done .cl-name { text-decoration: line-through; color: #aaa; }

      .tracker-add-task-row { display: flex; gap: 8px; margin-top: 4px; }
      .tracker-empty { color: #aaa; font-size: 14px; text-align: center; padding: 24px 0; }

      /* ── Deadline badges ── */
      .deadline-badge { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 10px; white-space: nowrap; }
      .deadline-ok      { background: #f1f5f9; color: #64748b; }
      .deadline-soon    { background: #fef9c3; color: #854d0e; }
      .deadline-overdue { background: #fee2e2; color: #b91c1c; }
      .tracker-goal-deadline { font-size: 12px; }
      .tracker-date-input { padding: 8px 10px; border: 1px solid #d0d7e3; border-radius: 6px; font-size: 13px; color: #333; }

      /* ── Modal ── */
      #tracker-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 999; }
      #tracker-modal-overlay.hidden { display: none; }
      .tracker-modal { background: #fff; border-radius: 10px; padding: 28px 32px; max-width: 360px; width: 90%; text-align: center; box-shadow: 0 12px 40px rgba(0,0,0,0.18); }
      .tracker-modal h3 { margin: 0 0 8px; font-size: 18px; }
      .tracker-modal p { margin: 0 0 20px; color: #555; font-size: 14px; }
      .tracker-modal-task { font-weight: 600; color: #111; }
      .tracker-modal-actions { display: flex; gap: 12px; justify-content: center; }
      .tracker-modal-actions .tracker-btn { min-width: 90px; }
      .tracker-btn-no { background: #e5e7eb; color: #333; }
      .tracker-btn-no:hover { background: #d1d5db; }

      /* ── Background overlay ── */
      #bg-overlay { position: fixed; inset: 0; z-index: -1; opacity: 0.35; transition: background 0.3s; pointer-events: none; }

      /* ── Color picker button ── */
      .color-picker-wrap { display: flex; align-items: center; gap: 6px; cursor: pointer; }
      .color-picker-wrap label { font-size: 13px; color: #555; cursor: pointer; white-space: nowrap; }
      #bg-color-picker { width: 28px; height: 28px; border: none; border-radius: 50%; cursor: pointer; padding: 0; background: none; }

      /* ── Topbar ── */
      .topbar { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; background: #fff; border-bottom: 1px solid #e2e8f0; }
      .topbar h1 { margin: 0; font-size: 28px; }

      /* ── Points badge ── */
      .points-badge { display: flex; align-items: center; gap: 6px; background: #fef9c3; border: 1px solid #fde047; border-radius: 20px; padding: 5px 14px; font-size: 14px; font-weight: 600; color: #854d0e; }
      .points-badge .points-icon { font-size: 16px; }

      /* ── Points toast ── */
      #points-toast { position: fixed; bottom: 24px; right: 24px; background: #22c55e; color: #fff; padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 600; box-shadow: 0 4px 16px rgba(0,0,0,0.15); opacity: 0; transform: translateY(10px); transition: opacity 0.3s, transform 0.3s; pointer-events: none; z-index: 1000; }
      #points-toast.show { opacity: 1; transform: translateY(0); }

      /* ── Corner pet ── */
      #corner-pet { position: fixed; bottom: 20px; left: 20px; z-index: 998; display: flex; flex-direction: column; align-items: center; cursor: pointer; user-select: none; }
      #pet-bubble { background: #fff; border: 2px solid #e2e8f0; border-radius: 12px; padding: 6px 12px; font-size: 12px; font-weight: 600; color: #333; margin-bottom: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); opacity: 0; transform: translateY(4px); transition: opacity 0.2s, transform 0.2s; white-space: nowrap; pointer-events: none; }
      #pet-bubble::after { content: ''; position: absolute; bottom: -8px; left: 50%; transform: translateX(-50%); border: 4px solid transparent; border-top-color: #e2e8f0; }
      #corner-pet:hover #pet-bubble { opacity: 1; transform: translateY(0); }
      #pet-emoji { width: 90px; height: auto; display: block; transition: transform 0.1s; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.15)); }
      #pet-toggle { font-size: 11px; color: #aaa; text-align: center; margin-top: 4px; background: rgba(255,255,255,0.7); border-radius: 8px; padding: 2px 8px; }
      #pet-toggle:hover { color: #0066ff; background: #fff; }

      @keyframes pet-float  { 0%,100%{ transform: translateY(0);        } 50%{ transform: translateY(-6px);      } }
      @keyframes pet-jump   { 0%,100%{ transform: translateY(0) scale(1);} 30%{ transform: translateY(-24px) scale(1.1);} 60%{ transform: translateY(-8px) scale(1.05);} }
      @keyframes pet-spin   { 0%{ transform: rotate(0deg) scale(1.1);  } 100%{ transform: rotate(360deg) scale(1.1); } }
      @keyframes pet-wiggle { 0%,100%{ transform: rotate(0deg);  } 20%{ transform: rotate(-15deg); } 40%{ transform: rotate(15deg); } 60%{ transform: rotate(-10deg); } 80%{ transform: rotate(10deg); } }
      @keyframes pet-shake  { 0%,100%{ transform: translateX(0);  } 20%{ transform: translateX(-6px); } 40%{ transform: translateX(6px); } 60%{ transform: translateX(-4px); } 80%{ transform: translateX(4px); } }

      #pet-emoji.idle   { animation: pet-float  3s ease-in-out infinite; }
      #pet-emoji.jump   { animation: pet-jump   0.6s ease forwards; }
      #pet-emoji.spin   { animation: pet-spin   0.6s linear forwards; }
      #pet-emoji.wiggle { animation: pet-wiggle 0.5s ease forwards; }
      #pet-emoji.shake  { animation: pet-shake  0.4s ease forwards; }

      /* ── Shop button ── */
      .shop-open-btn { 
        padding: 8px 16px; 
        background: skyblue; 
        color: #fff; 
        border: none; 
        border-radius: 20px; 
        cursor: pointer; 
        font-size: 14px; 
        font-weight: 600; 
        white-space: nowrap; 
      }
      .shop-open-btn:hover { 
        background: #0066ff; 
        color: #fff; 
        border-color: #0066ff;  
      }

      /* ── Tutorial button ── */
      .tutorial-btn { 
        height: 36px; 
        padding: 0 14px; 
        border-radius: 18px; 
        border: 2px solid #e2e8f0; 
        background: #fff; 
        color: #555; 
        font-size: 14px; 
        font-weight: 600; 
        cursor: pointer; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        flex-shrink: 0; 
        white-space: nowrap; 
        transition: background 0.15s, border-color 0.15s, color 0.15s; 
      }
      .tutorial-btn:hover { 
        background: #0066ff; 
        color: #fff; 
        border-color: #0066ff; 
      }

      /* ── Logout button ── */
      .tracker-btn {
        padding: 8px 16px; 
        border-radius: 20px; 
        border: none; 
        background: #e5e7eb; 
        color: #333; 
        font-size: 14px; 
        font-weight: 600; 
        cursor: pointer; 
      }

      .tracker-btn:hover { 
        background: #0066ff; 
        color: #fff; 
        border-color: #0066ff; 
      }

      /* ── Shop modal ── */
      #shop-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1001; padding: 16px; }
      #shop-modal-overlay.hidden { display: none; }
      .shop-modal { background: #fff; border-radius: 14px; width: 100%; max-width: 580px; max-height: 85vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,0.3); overflow: hidden; }
      .shop-modal-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px 14px; border-bottom: 1px solid #e2e8f0; }
      .shop-modal-header h2 { margin: 0; font-size: 20px; }
      .shop-modal-pts { background: #fef9c3; border: 1px solid #fde047; border-radius: 16px; padding: 4px 12px; font-size: 14px; font-weight: 600; color: #854d0e; }
      .shop-close-btn { background: none; border: none; font-size: 20px; cursor: pointer; color: #999; padding: 4px 8px; border-radius: 6px; line-height: 1; }
      .shop-close-btn:hover { background: #f0f0f0; color: #333; }
      .shop-tabs { display: flex; gap: 4px; padding: 10px 24px; border-bottom: 1px solid #e2e8f0; }
      .shop-tab { padding: 7px 16px; border: none; background: none; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer; color: #666; }
      .shop-tab:hover { background: #f0f0f0; }
      .shop-tab.active { background: #0066ff; color: #fff; }
      #shop-items { padding: 16px 20px 20px; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(148px, 1fr)); gap: 12px; gap: 12px; max-height: 60vh; }
      .shop-item { border: 2px solid #e2e8f0; border-radius: 20px 20px 44px 44px; overflow: hidden; background: #fff; min-height: 145px; display: flex; flex-direction: column; }
      .shop-item.active-item { border-color: #0066ff; }
      .shop-preview-bg { height: 95px; width: 100%; border-radius: 12px 12px 0 0; flex-shrink: 0; }
      .shop-preview-pet { height: 84px; display: flex; align-items: center; justify-content: center; background: #f8fafc; }
      .shop-preview-pet img { height: 68px; width: auto; }
      .shop-preview-theme { height: 76px; display: flex; align-items: center; justify-content: center; font-size: 30px; }
      .theme-preview-dark   { background: linear-gradient(135deg, #1e1e2e 0%, #2d2d4e 100%); }
      .theme-preview-pastel { background: linear-gradient(135deg, #ffe8f8 0%, #ead8ff 100%); }
      .theme-preview-nature { background: linear-gradient(135deg, #e8f5e8 0%, #c8e6c0 100%); }
      .shop-item-info { padding: 8px 10px; display: flex; justify-content: space-between; align-items: center; min-height: 20px;}
      .shop-item-label { font-size: 12px; font-weight: 600; color: #222; }
      .shop-item-price { font-size: 12px; color: #854d0e; font-weight: 600; background: #fef9c3; padding: 2px 7px; border-radius: 8px; white-space: nowrap; }
      .shop-owned-badge { font-size: 12px; color: #22c55e; font-weight: 600; }
      .shop-buy-btn, .shop-apply-btn {
        margin-top: auto; 
        margin-bottom: 0; 
        width: 100%; 
        padding: 10px; 
        font-size: 13px; 
        font-weight: 600; 
        border: none; 
        cursor: pointer; 
        margin-top: 6px; 
        border-radius: 0 0 40px 40px; 
        display: block; 
      }
      .shop-buy-btn { background: #0066ff; color: #fff; }
      .shop-buy-btn:hover:not(:disabled) { background: #0052cc; }
      .shop-buy-btn:disabled { background: #e5e7eb; color: #aaa; cursor: not-allowed; }
      .shop-apply-btn { background: #e5e7eb; color: #333;}
      .shop-apply-btn:hover { background: #d1d5db; }
      .shop-apply-btn.shop-active-btn { background: #22c55e; color: #fff; }
      .shop-apply-btn.shop-active-btn:hover { background: #16a34a; }
      .shop-empty { color: #aaa; font-size: 14px; text-align: center; padding: 32px 0; grid-column: 1/-1; }

    .shop-preview-bg,
    .shop-preview-pet,
    .shop-preview-theme,
    .shop-preview-accent,
    .shop-preview-extra {
      height: 105px;
      min-height: 105px;
      max-height: 105px;
      flex-shrink: 0;
      border-radius: 14px 14px 0 0;
    }

    .shop-item {
      min-height: 180px;
      height: 180px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .shop-buy-btn,
    .shop-apply-btn {
      height: 42px;
      padding: 0;
      margin-top: auto;
      margin-bottom: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

      /* ── Themes ── */
      [data-theme="dark"] body { background: #0f0f1a; color: #e2e8f0; }
      [data-theme="dark"] .topbar { background: #1e1e2e !important; border-color: #2d2d4e !important; }
      [data-theme="dark"] h1, [data-theme="dark"] h2 { color: #e2e8f0; }
      [data-theme="dark"] .tracker-goal, [data-theme="dark"] .cl-goal { background: #1e1e2e; border-color: #2d2d4e; }
      [data-theme="dark"] .tracker-task { border-color: #2d2d4e; }
      [data-theme="dark"] .tracker-task-name { color: #d4d8e2; }
      [data-theme="dark"] .tracker-task-done .tracker-task-name { color: #555; }
      [data-theme="dark"] .tracker-goal-title { color: #e2e8f0; }
      [data-theme="dark"] .tracker-goal-progress { color: #888; }
      [data-theme="dark"] .tracker-input, [data-theme="dark"] .tracker-date-input { background: #252538; border-color: #3d3d5c; color: #e2e8f0; }
      [data-theme="dark"] .tracker-btn-no { background: #2d2d4e; color: #d4d8e2; }
      [data-theme="dark"] .tracker-btn-no:hover { background: #3d3d5e; }
      [data-theme="dark"] .tracker-modal { background: #1e1e2e; }
      [data-theme="dark"] .tracker-modal h3, [data-theme="dark"] .tracker-modal-task { color: #e2e8f0; }
      [data-theme="dark"] .tracker-modal p { color: #aaa; }
      [data-theme="dark"] #pet-bubble { background: #1e1e2e; border-color: #2d2d4e; color: #e2e8f0; }
      [data-theme="dark"] .cl-goal-title { color: #60a5fa !important; }
      [data-theme="dark"] .cl-item { border-color: #2d2d4e; }
      [data-theme="dark"] .tracker-btn-icon { color: #555; }
      [data-theme="dark"] .tracker-btn-icon:hover { background: #2d2d4e; color: #f87171; }
      [data-theme="dark"] #bg-overlay { opacity: 0 !important; }
      [data-theme="dark"] .shop-modal { background: #1e1e2e; color: #e2e8f0; }
      [data-theme="dark"] .shop-modal-header { border-color: #2d2d4e; }
      [data-theme="dark"] .shop-modal-header h2 { color: #e2e8f0; }
      [data-theme="dark"] .shop-tabs { border-color: #2d2d4e; }
      [data-theme="dark"] .shop-tab { color: #aaa; }
      [data-theme="dark"] .shop-tab:hover { background: #2d2d4e; color: #e2e8f0; }
      [data-theme="dark"] .shop-item { border-color: #2d2d4e; background: #252538; }
      [data-theme="dark"] .shop-item.active-item { border-color: #60a5fa; }
      [data-theme="dark"] .shop-item-label { color: #d4d8e2; }
      [data-theme="dark"] .shop-apply-btn { background: #2d2d4e; color: #d4d8e2; }
      [data-theme="dark"] .shop-apply-btn:hover { background: #3d3d5e; }
      [data-theme="dark"] .shop-close-btn:hover { background: #2d2d4e; color: #e2e8f0; }
      [data-theme="dark"] .shop-preview-pet { background: #252538; }

      [data-theme="pastel"] .topbar { background: #fff8fd !important; border-color: #f0c8e8 !important; }
      [data-theme="pastel"] .tracker-goal, [data-theme="pastel"] .cl-goal { background: #fffafd; border-color: #f0c8e8; }
      [data-theme="pastel"] .tracker-task { border-color: #f8e0f0; }
      [data-theme="pastel"] .tracker-btn { background: #d946a8; }
      [data-theme="pastel"] .tracker-btn:hover { background: #b8357a; }
      [data-theme="pastel"] .tracker-btn-no { background: #ffe8f5; color: #8b3060; }
      [data-theme="pastel"] .cl-goal-title { color: #c2186c !important; }
      [data-theme="pastel"] .cl-done .cl-check { color: #d946a8; }
      [data-theme="pastel"] .tracker-done-badge { color: #d946a8; }
      [data-theme="pastel"] .points-badge { background: #ffe8f5; border-color: #f0a8d0; color: #8b2060; }
      [data-theme="pastel"] .tracker-input, [data-theme="pastel"] .tracker-date-input { border-color: #f0c8e8; }
      [data-theme="pastel"] #bg-overlay { background: linear-gradient(135deg,#ffe8f8 0%,#ead8ff 100%) !important; opacity: 0.5 !important; }

      [data-theme="nature"] .topbar { background: #f4f9ee !important; border-color: #b8d898 !important; }
      [data-theme="nature"] .tracker-goal, [data-theme="nature"] .cl-goal { background: #f8fbf4; border-color: #c8e4a8; }
      [data-theme="nature"] .tracker-task { border-color: #e0efd0; }
      [data-theme="nature"] .tracker-btn { background: #3d8b3d; }
      [data-theme="nature"] .tracker-btn:hover { background: #2d6b2d; }
      [data-theme="nature"] .tracker-btn-no { background: #e8f0e8; color: #3d5a3d; }
      [data-theme="nature"] .cl-goal-title { color: #2d6b2d !important; }
      [data-theme="nature"] .cl-done .cl-check { color: #3d8b3d; }
      [data-theme="nature"] .tracker-done-badge { color: #3d8b3d; }
      [data-theme="nature"] .points-badge { background: #eaf5e8; border-color: #b0d890; color: #2d5a2d; }
      [data-theme="nature"] .tracker-input, [data-theme="nature"] .tracker-date-input { border-color: #b8d898; }
      [data-theme="nature"] #bg-overlay { background: linear-gradient(135deg,#d4edda 0%,#c8e6c0 100%) !important; opacity: 0.45 !important; }

      /* ── Candy theme ── */
      [data-theme="candy"] .topbar { background: linear-gradient(90deg,#ff9de2,#ffcc44,#9de2ff) !important; border: none !important; }
      [data-theme="candy"] .tracker-goal, [data-theme="candy"] .cl-goal { background: #fff8ff; border-color: #ffb3de; }
      [data-theme="candy"] .tracker-task { border-color: #ffe0f0; }
      [data-theme="candy"] .tracker-btn { background: linear-gradient(135deg,#ff6eb4,#ff44aa); }
      [data-theme="candy"] .tracker-btn:hover { background: linear-gradient(135deg,#ff44aa,#cc1188); }
      [data-theme="candy"] .tracker-btn-no { background: #ffe8f5; color: #880055; }
      [data-theme="candy"] .cl-goal-title { color: #dd22aa !important; }
      [data-theme="candy"] .points-badge { background: #fff0f8; border-color: #ffb3de; color: #cc1177; }
      [data-theme="candy"] .tracker-done-badge { color: #dd22aa; }
      [data-theme="candy"] #bg-overlay { background: linear-gradient(135deg,#ffccee 0%,#ffeecc 50%,#ccddff 100%) !important; opacity: 0.5 !important; }

      /* ── Vaporwave theme ── */
      [data-theme="vaporwave"] body { background: #1a0033; color: #e0d0ff; }
      [data-theme="vaporwave"] .topbar { background: #250044 !important; border-color: #6600cc !important; }
      [data-theme="vaporwave"] h1, [data-theme="vaporwave"] h2 { color: #ff71ce; }
      [data-theme="vaporwave"] .tracker-goal, [data-theme="vaporwave"] .cl-goal { background: #1e0038; border-color: #6600cc; }
      [data-theme="vaporwave"] .tracker-goal-title { color: #b5a9ff; }
      [data-theme="vaporwave"] .tracker-task { border-color: #330066; }
      [data-theme="vaporwave"] .tracker-task-name { color: #d4c8ff; }
      [data-theme="vaporwave"] .tracker-task-done .tracker-task-name { color: #664488; }
