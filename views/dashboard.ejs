      [data-accent="gold"] .tracker-checkbox { accent-color: #d97706; }
      [data-accent="gold"] .cl-goal-title { color: #d97706 !important; }
      [data-accent="gold"] .tracker-done-badge { color: #d97706; }
      /* Slate */
      [data-accent="slate"] .tracker-btn, [data-accent="slate"] .shop-tab.active, [data-accent="slate"] .shop-buy-btn, [data-accent="slate"] .shop-apply-btn.shop-active-btn { background: #475569; }
      [data-accent="slate"] .tracker-btn:hover { background: #334155; }
      [data-accent="slate"] .tracker-checkbox { accent-color: #475569; }
      [data-accent="slate"] .cl-goal-title { color: #475569 !important; }
      [data-accent="slate"] .tracker-done-badge { color: #475569; }

      /* ── Accent & Extra shop previews ── */
      .shop-preview-accent { height: 76px; background: #f8fafc; display: flex; align-items: center; justify-content: center; }
      .accent-demo { width: 74px; height: 50px; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
      .accent-demo-text { color: #fff; font-size: 20px; font-weight: 800; line-height: 1; }
      .accent-demo-bar { height: 4px; width: 42px; background: rgba(255,255,255,0.55); border-radius: 2px; }
      .shop-preview-extra { height: 76px; background: linear-gradient(135deg,#fef9c3,#fde68a); display: flex; align-items: center; justify-content: center; font-size: 34px; }

      /* ── Pomodoro Timer ── */
      #pomo-section { max-width: 640px; margin: 28px auto 0; padding: 0 16px 28px; border-bottom: 1px solid #e2e8f0; }
      .pomo-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
      .pomo-header h2 { margin: 0; font-size: 20px; }
      .pomo-settings { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px 18px; margin-bottom: 20px; }
      .pomo-settings.hidden { display: none; }
      .pomo-settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin-bottom: 12px; }
      .pomo-settings-label { font-size: 12px; color: #666; font-weight: 600; display: flex; flex-direction: column; gap: 5px; }
      .pomo-settings input[type="number"] { padding: 7px 10px; border: 1px solid #d0d7e3; border-radius: 6px; font-size: 15px; font-weight: 700; color: #111; width: 100%; box-sizing: border-box; }
      .pomo-settings-hint { font-size: 12px; color: #aaa; }
      .pomo-modes { display: flex; gap: 6px; justify-content: center; margin-bottom: 24px; flex-wrap: wrap; }
      .pomo-mode-btn { padding: 7px 18px; border: 1.5px solid #e2e8f0; background: #fff; border-radius: 20px; font-size: 13px; font-weight: 500; cursor: pointer; color: #666; transition: background 0.15s, border-color 0.15s, color 0.15s; }
      .pomo-mode-btn:hover { border-color: #cbd5e1; background: #f8fafc; }
      .pomo-mode-btn[data-mode="work"].active  { background: #ef4444; color: #fff; border-color: #ef4444; }
      .pomo-mode-btn[data-mode="short"].active { background: #22c55e; color: #fff; border-color: #22c55e; }
      .pomo-mode-btn[data-mode="long"].active  { background: #3b82f6; color: #fff; border-color: #3b82f6; }
      .pomo-ring-wrap { position: relative; width: 220px; height: 220px; margin: 0 auto 24px; }
      .pomo-ring { width: 100%; height: 100%; transform: rotate(-90deg); }
      .pomo-ring-bg   { fill: none; stroke: #e2e8f0; stroke-width: 10; }
      .pomo-ring-fill { fill: none; stroke: #ef4444; stroke-width: 10; stroke-linecap: round; transition: stroke-dashoffset 1s linear, stroke 0.4s; }
      .pomo-ring-inner { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; }
      .pomo-time { font-size: 52px; font-weight: 700; color: #111; font-variant-numeric: tabular-nums; letter-spacing: -2px; line-height: 1; }
      .pomo-mode-label { font-size: 13px; color: #888; font-weight: 500; margin-top: 4px; }
      .pomo-controls { display: flex; gap: 12px; justify-content: center; align-items: center; margin-bottom: 20px; }
      .pomo-ctrl-btn { border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: background 0.15s; padding: 10px 20px; }
      .pomo-ctrl-primary { background: #ef4444; color: #fff; min-width: 130px; font-size: 16px; padding: 13px 28px; border-radius: 10px; }
      .pomo-ctrl-primary:hover { background: #dc2626; }
      .pomo-ctrl-primary.running { background: #f97316; }
      .pomo-ctrl-primary.running:hover { background: #ea580c; }
      .pomo-ctrl-secondary { background: #f1f5f9; color: #555; }
      .pomo-ctrl-secondary:hover { background: #e2e8f0; color: #333; }
      .pomo-dots { display: flex; gap: 8px; justify-content: center; padding-bottom: 8px; }
      .pomo-dot { width: 14px; height: 14px; border-radius: 50%; background: #e2e8f0; transition: background 0.3s; }
      .pomo-dot.done { background: #ef4444; }
      /* pomo theme overrides */
      [data-theme="dark"] #pomo-section { border-color: #2d2d4e; }
      [data-theme="dark"] .pomo-time { color: #e2e8f0; }
      [data-theme="dark"] .pomo-mode-label { color: #888; }
      [data-theme="dark"] .pomo-ring-bg { stroke: #2d2d4e; }
      [data-theme="dark"] .pomo-settings { background: #1e1e2e; border-color: #2d2d4e; }
      [data-theme="dark"] .pomo-settings-label { color: #aaa; }
      [data-theme="dark"] .pomo-settings input[type="number"] { background: #252538; border-color: #3d3d5c; color: #e2e8f0; }
      [data-theme="dark"] .pomo-mode-btn { background: #1e1e2e; border-color: #2d2d4e; color: #aaa; }
      [data-theme="dark"] .pomo-mode-btn:hover { background: #2d2d4e; }
      [data-theme="dark"] .pomo-ctrl-secondary { background: #2d2d4e; color: #d4d8e2; }
      [data-theme="dark"] .pomo-ctrl-secondary:hover { background: #3d3d5e; }
      [data-theme="dark"] .pomo-dot { background: #2d2d4e; }
      [data-theme="vaporwave"] #pomo-section { border-color: #330066; }
      [data-theme="vaporwave"] .pomo-time { color: #ff71ce; }
      [data-theme="vaporwave"] .pomo-mode-label { color: #b5a9ff; }
      [data-theme="vaporwave"] .pomo-ring-bg { stroke: #330066; }
      [data-theme="vaporwave"] .pomo-settings { background: #1e0038; border-color: #6600cc; }
      [data-theme="vaporwave"] .pomo-settings-label { color: #b5a9ff; }
      [data-theme="vaporwave"] .pomo-settings input[type="number"] { background: #1a0033; border-color: #6600cc; color: #d4c8ff; }
      [data-theme="vaporwave"] .pomo-mode-btn { background: #1e0038; border-color: #6600cc; color: #b5a9ff; }
      [data-theme="vaporwave"] .pomo-mode-btn:hover { background: #330066; }
      [data-theme="vaporwave"] .pomo-mode-btn[data-mode="work"].active { background: #ff71ce; border-color: #ff71ce; }
      [data-theme="vaporwave"] .pomo-ctrl-secondary { background: #330066; color: #d4c8ff; }
      [data-theme="vaporwave"] .pomo-dot { background: #330066; }
      [data-theme="vaporwave"] .pomo-dot.done { background: #ff71ce; }
      [data-theme="pastel"] .pomo-mode-btn[data-mode="work"].active { background: #d946a8; border-color: #d946a8; }
      [data-theme="pastel"] .pomo-ctrl-primary { background: #d946a8; }
      [data-theme="pastel"] .pomo-ctrl-primary:hover { background: #b8357a; }
      [data-theme="pastel"] .pomo-ctrl-primary.running { background: #f97316; }
      [data-theme="pastel"] .pomo-dot.done { background: #d946a8; }
      [data-theme="nature"] .pomo-mode-btn[data-mode="work"].active { background: #3d8b3d; border-color: #3d8b3d; }
      [data-theme="nature"] .pomo-ctrl-primary { background: #3d8b3d; }
      [data-theme="nature"] .pomo-ctrl-primary:hover { background: #2d6b2d; }
      [data-theme="nature"] .pomo-ctrl-primary.running { background: #f97316; }
      [data-theme="nature"] .pomo-dot.done { background: #3d8b3d; }
      [data-theme="beach"] .pomo-ctrl-primary.running { background: #f97316; }


      /* ── Calculator button ── */
      .calc-open-btn { width: 36px; height: 36px; border-radius: 50%; border: 2px solid #e2e8f0; background: #fff; color: #555; font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.15s, border-color 0.15s; }
      .calc-open-btn:hover { background: #0066ff; border-color: #0066ff; }

      /* ── Calculator modal ── */
      #calc-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 1002; }
      #calc-modal-overlay.hidden { display: none; }
      .calc-modal { background: #1c1c1e; border-radius: 20px; width: 280px; overflow: hidden; box-shadow: 0 24px 80px rgba(0,0,0,0.55); }
      .calc-header { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px 0; }
      .calc-header span { color: #888; font-size: 13px; font-weight: 600; letter-spacing: 0.5px; }
      .calc-close-btn { background: none; border: none; font-size: 18px; cursor: pointer; color: #555; padding: 4px 6px; border-radius: 6px; line-height: 1; }
      .calc-close-btn:hover { color: #aaa; }
      .calc-display { padding: 14px 18px 10px; text-align: right; }
      .calc-expression { font-size: 15px; color: #666; min-height: 22px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .calc-result { font-size: 54px; font-weight: 300; color: #fff; line-height: 1.1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-variant-numeric: tabular-nums; }
      .calc-buttons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: #3a3a3c; border-top: 1px solid #3a3a3c; }
      .calc-btn { padding: 0; aspect-ratio: 1; font-size: 22px; font-weight: 400; border: none; cursor: pointer; transition: filter 0.1s; background: #333335; color: #fff; display: flex; align-items: center; justify-content: center; }
      .calc-btn:hover { filter: brightness(1.25); }
      .calc-btn:active { filter: brightness(0.75); }
      .calc-btn-fn { background: #636366; color: #000; font-weight: 500; }
      .calc-btn-op { background: #ff9f0a; color: #fff; }
      .calc-btn-op.active-op { background: #fff; color: #ff9f0a; }
      .calc-btn-zero { grid-column: span 2; aspect-ratio: auto; justify-content: flex-start; padding: 0 0 0 28px; border-bottom-left-radius: 20px; }
      .calc-btn:last-child { border-bottom-right-radius: 20px; }

      /* ── Tutorial overlay (4-panel spotlight) ── */
      .tut-panel { position: fixed; background: rgba(0,0,0,0.6); z-index: 10000; pointer-events: all; transition: all 0.25s ease; }
      #tut-ring { position: fixed; z-index: 10001; border: 2.5px solid #4d96ff; border-radius: 10px; box-shadow: 0 0 0 4px rgba(77,150,255,0.2); pointer-events: none; transition: all 0.25s ease; }

      /* ── Tutorial tooltip ── */
      #tutorial-tooltip { position: fixed; z-index: 10002; width: 320px; background: #fff; border-radius: 14px; padding: 22px 22px 16px; box-shadow: 0 16px 48px rgba(0,0,0,0.28); display: none; }
      #tutorial-tooltip.visible { display: block; }
      #tut-step-num { font-size: 11px; font-weight: 700; color: #aaa; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
      #tut-title { font-size: 16px; font-weight: 700; color: #111; margin: 0 0 9px; }
      #tut-body { font-size: 13px; color: #555; line-height: 1.6; margin: 0 0 18px; }
      .tut-actions { display: flex; align-items: center; justify-content: space-between; }
      #tut-skip { background: none; border: none; font-size: 13px; color: #bbb; cursor: pointer; padding: 0; }
      #tut-skip:hover { color: #888; }
      .tut-nav { display: flex; gap: 8px; }
      #tut-prev, #tut-next { padding: 8px 16px; border: none; border-radius: 7px; font-size: 14px; font-weight: 600; cursor: pointer; }
      #tut-prev { background: #f1f5f9; color: #555; }
      #tut-prev:hover { background: #e2e8f0; }
      #tut-prev:disabled { opacity: 0.3; cursor: default; }
      #tut-next { background: #0066ff; color: #fff; }
      #tut-next:hover { background: #0052cc; }
      /* dark theme */
      [data-theme="dark"] #tutorial-tooltip { background: #1e1e2e; }
      [data-theme="dark"] #tut-title { color: #e2e8f0; }
      [data-theme="dark"] #tut-body { color: #aaa; }
      [data-theme="dark"] #tut-step-num { color: #555; }
      [data-theme="dark"] #tut-prev { background: #2d2d4e; color: #d4d8e2; }
      [data-theme="dark"] #tut-skip { color: #555; }
      /* vaporwave theme */
      [data-theme="vaporwave"] #tutorial-tooltip { background: #1e0038; border: 1px solid #6600cc; }
      [data-theme="vaporwave"] #tut-title { color: #ff71ce; }
      [data-theme="vaporwave"] #tut-body { color: #b5a9ff; }
      [data-theme="vaporwave"] #tut-prev { background: #330066; color: #d4c8ff; }

      /* ── Confetti ── */
      @keyframes confetti-fall {
        0%   { transform: translateY(-20px) rotate(0deg);    opacity: 1; }
        80%  { opacity: 1; }
        100% { transform: translateY(105vh) rotate(720deg);  opacity: 0; }
      }
      .confetti-piece { position: absolute; top: -10px; animation: confetti-fall linear forwards; }
    </style>
  </head>
  <body>
    <div id="bg-overlay"></div>
    <div class="topbar">
      <h1>New Year Tracker</h1>
      <div style="display:flex;align-items:center;gap:12px;">
        <div class="color-picker-wrap">
          <label for="bg-color-picker">Background</label>
          <input type="color" id="bg-color-picker" title="Change background color">
        </div>
        <button class="shop-open-btn" id="shop-open-btn">🛒 Shop</button>
        <button class="tutorial-btn" id="tutorial-open-btn" title="How it works">Tutorial For You</button>
        <button class="calc-open-btn" id="calc-open-btn" title="Calculator">🧮</button>
        <div id="trophy-display" style="display:none;align-items:center;gap:4px;background:#fef9c3;border:1px solid #fde047;border-radius:20px;padding:4px 12px;font-size:13px;font-weight:600;color:#854d0e;cursor:default;"></div>
        <div class="points-badge"><span class="points-icon">⭐</span><span id="points-display"></span> pts</div>
        <span style="font-size:22px;color:#555;">👋 <%= user.name || user.username %></span>
        <form method="POST" action="/logout" style="margin:0;">
          <button type="submit" class="tracker-btn tracker-btn-sm" >Logout</button>
        </form>
      </div>
    </div>

    <!-- Pomodoro Timer -->
    <div id="pomo-section">
      <div class="pomo-header">
        <h2>🍅 Pomodoro</h2>
        <button class="tracker-btn-icon" id="pomo-settings-btn" title="Timer settings" style="font-size:18px;">⚙️</button>
      </div>

      <div id="pomo-settings-panel" class="pomo-settings hidden">
        <div class="pomo-settings-grid">
          <label class="pomo-settings-label">Focus (min)
            <input type="number" id="pomo-work-input" min="1" max="90" value="25">
          </label>
          <label class="pomo-settings-label">Short break (min)
            <input type="number" id="pomo-short-input" min="1" max="30" value="5">
          </label>
          <label class="pomo-settings-label">Long break (min)
            <input type="number" id="pomo-long-input" min="1" max="60" value="15">
          </label>
          <label class="pomo-settings-label">Sessions until long break
            <input type="number" id="pomo-interval-input" min="2" max="8" value="4">
          </label>
        </div>
        <div style="display:flex;align-items:center;gap:10px;">
          <button class="tracker-btn tracker-btn-sm" id="pomo-save-btn">Save</button>
          <span class="pomo-settings-hint">Saving resets the current timer.</span>
        </div>
      </div>

      <div class="pomo-modes">
        <button class="pomo-mode-btn active" data-mode="work">Focus</button>
        <button class="pomo-mode-btn" data-mode="short">Short Break</button>
        <button class="pomo-mode-btn" data-mode="long">Long Break</button>
      </div>

      <div class="pomo-ring-wrap">
        <svg class="pomo-ring" viewBox="0 0 200 200">
          <circle class="pomo-ring-bg" cx="100" cy="100" r="88"/>
          <circle class="pomo-ring-fill" id="pomo-ring-fill" cx="100" cy="100" r="88"/>
        </svg>
        <div class="pomo-ring-inner">
          <div id="pomo-time" class="pomo-time">25:00</div>
          <div id="pomo-mode-label" class="pomo-mode-label">Focus</div>
        </div>
      </div>

      <div class="pomo-controls">
        <button class="pomo-ctrl-btn pomo-ctrl-secondary" id="pomo-reset-btn">↩ Reset</button>
        <button class="pomo-ctrl-btn pomo-ctrl-primary" id="pomo-start-btn">▶ Start</button>
        <button class="pomo-ctrl-btn pomo-ctrl-secondary" id="pomo-skip-btn">⏭ Skip</button>
      </div>

      <div id="pomo-dots" class="pomo-dots"></div>
    </div>

    <div class="tracker-wrap">
      <h2>My Goals & Tasks</h2>

      <div class="tracker-add-goal-row">
        <input class="tracker-input" type="text" id="goal-input" placeholder="Enter a new goal…">
        <input class="tracker-date-input" type="date" id="goal-deadline" title="Goal deadline (optional)">
        <button class="tracker-btn" id="add-goal-btn">Add Goal</button>
      </div>

      <div id="goal-list"></div>
      <div id="checklist-section"></div>
    </div>

    <!-- Completion prompt modal -->
    <div id="tracker-modal-overlay" class="hidden">
      <div class="tracker-modal">
        <h3>Did you complete the task?</h3>
        <p class="tracker-modal-task" id="tracker-modal-task-name"></p>
        <div class="tracker-modal-actions">
          <button class="tracker-btn" id="tracker-modal-yes">Yes</button>
          <button class="tracker-btn tracker-btn-no" id="tracker-modal-no">No</button>
        </div>
      </div>
    </div>

    <!-- Corner pet -->
    <div id="corner-pet">
      <div id="pet-bubble">Hello! 👋</div>
      <img id="pet-emoji" class="idle" src="/pet-cat.svg" alt="pet">
      <span id="pet-toggle">switch pet</span>
    </div>

    <!-- Reward shop modal -->
    <div id="shop-modal-overlay" class="hidden">
      <div class="shop-modal">
        <div class="shop-modal-header">
          <h2>🛒 Reward Shop</h2>
          <div style="display:flex;align-items:center;gap:12px;">
            <span class="shop-modal-pts">⭐ <span id="shop-pts-display">0</span> pts</span>
            <button class="shop-close-btn" id="shop-close-btn">✕</button>
          </div>
        </div>
        <div class="shop-tabs">
          <button class="shop-tab active" data-tab="bg">🌅 Backgrounds</button>
          <button class="shop-tab" data-tab="pet">🐾 Animals</button>
          <button class="shop-tab" data-tab="accent">🎨 Colors</button>
          <button class="shop-tab" data-tab="theme">✨ Themes</button>
          <button class="shop-tab" data-tab="extra">🎁 Extras</button>
        </div>
        <div id="shop-items"></div>
      </div>
    </div>

    <!-- Calculator modal -->
    <div id="calc-modal-overlay" class="hidden">
      <div class="calc-modal">
        <div class="calc-header">
          <span>CALCULATOR</span>
          <button class="calc-close-btn" id="calc-close-btn">✕</button>
        </div>
        <div class="calc-display">
          <div class="calc-expression" id="calc-expression"></div>
          <div class="calc-result" id="calc-result">0</div>
        </div>
        <div class="calc-buttons">
          <button class="calc-btn calc-btn-fn" data-action="clear">C</button>
          <button class="calc-btn calc-btn-fn" data-action="sign">±</button>
          <button class="calc-btn calc-btn-fn" data-action="percent">%</button>
          <button class="calc-btn calc-btn-op" data-action="op" data-op="÷">÷</button>
          <button class="calc-btn" data-action="num" data-val="7">7</button>
          <button class="calc-btn" data-action="num" data-val="8">8</button>
          <button class="calc-btn" data-action="num" data-val="9">9</button>
          <button class="calc-btn calc-btn-op" data-action="op" data-op="×">×</button>
          <button class="calc-btn" data-action="num" data-val="4">4</button>
          <button class="calc-btn" data-action="num" data-val="5">5</button>
          <button class="calc-btn" data-action="num" data-val="6">6</button>
          <button class="calc-btn calc-btn-op" data-action="op" data-op="−">−</button>
          <button class="calc-btn" data-action="num" data-val="1">1</button>
          <button class="calc-btn" data-action="num" data-val="2">2</button>
          <button class="calc-btn" data-action="num" data-val="3">3</button>
          <button class="calc-btn calc-btn-op" data-action="op" data-op="+">+</button>
          <button class="calc-btn calc-btn-zero" data-action="num" data-val="0">0</button>
          <button class="calc-btn" data-action="decimal">.</button>
          <button class="calc-btn calc-btn-op" data-action="equals">=</button>
        </div>
      </div>
    </div>

    <div id="confetti-container" style="position:fixed;inset:0;pointer-events:none;z-index:9999;overflow:hidden;"></div>
    <div id="points-toast"></div>
    <script src="/tracker.js"></script>
    <script src="/pomo.js"></script>
    <script src="/tutorial.js"></script>
    <script>
    // ── Calculator ──────────────────────────────────────────────────────────────
    (function () {
      const overlay  = document.getElementById('calc-modal-overlay');
      const openBtn  = document.getElementById('calc-open-btn');
      const closeBtn = document.getElementById('calc-close-btn');
      const resultEl = document.getElementById('calc-result');
      const exprEl   = document.getElementById('calc-expression');

      let display          = '0';
      let operand          = null;
      let operator         = null;
      let waitingForNext   = false;

      function fmt(val) {
        const s = String(val);
        return s.length > 12 ? parseFloat(parseFloat(val).toPrecision(9)).toString() : s;
      }

      function updateDisplay() { resultEl.textContent = fmt(display); }

      function inputNum(v) {
        if (waitingForNext) { display = v; waitingForNext = false; }
        else { display = display === '0' ? v : display + v; }
        updateDisplay();
      }

      function inputDecimal() {
        if (waitingForNext) { display = '0.'; waitingForNext = false; }
        else if (!display.includes('.')) display += '.';
        updateDisplay();
      }

      function calc(a, op, b) {
        a = parseFloat(a); b = parseFloat(b);
        if (op === '÷') return b !== 0 ? a / b : 'Error';
        if (op === '×') return a * b;
        if (op === '−') return a - b;
        if (op === '+') return a + b;
        return b;
      }

      function setActiveOp(op) {
        document.querySelectorAll('.calc-btn-op').forEach(b =>
          b.classList.toggle('active-op', b.dataset.op === op)
        );
      }

      function handleOp(op) {
        if (operator && !waitingForNext) {
          const res = calc(operand, operator, display);
          display = fmt(res);
          updateDisplay();
        }
        operand = display;
        operator = op;
        waitingForNext = true;
        exprEl.textContent = `${operand} ${op}`;
        setActiveOp(op);
      }

      function handleEquals() {
        if (operator === null) return;
        const res = calc(operand, operator, display);
        exprEl.textContent = `${operand} ${operator} ${display} =`;
        display = fmt(res);
        updateDisplay();
        operator = null; operand = null; waitingForNext = true;
        setActiveOp(null);
      }

      function handleClear() {
        display = '0'; operand = null; operator = null; waitingForNext = false;
        exprEl.textContent = '';
        setActiveOp(null);
        updateDisplay();
      }

      document.querySelectorAll('.calc-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const { action, val, op } = btn.dataset;
          if (action === 'num')     inputNum(val);
          if (action === 'decimal') inputDecimal();
          if (action === 'op')      handleOp(op);
          if (action === 'equals')  handleEquals();
          if (action === 'clear')   handleClear();
          if (action === 'sign') {
            display = String(-parseFloat(display) || 0);
            updateDisplay();
          }
          if (action === 'percent') {
            display = String(parseFloat(display) / 100);
            updateDisplay();
          }
        });
      });

      openBtn.addEventListener('click',  () => overlay.classList.remove('hidden'));
      closeBtn.addEventListener('click', () => overlay.classList.add('hidden'));
      overlay.addEventListener('click',  e => { if (e.target === overlay) overlay.classList.add('hidden'); });

      document.addEventListener('keydown', e => {
        if (overlay.classList.contains('hidden')) return;
        if (e.key >= '0' && e.key <= '9') { inputNum(e.key); return; }
        if (e.key === '.')               { inputDecimal(); return; }
        if (e.key === '+')               { handleOp('+');  return; }
        if (e.key === '-')               { handleOp('−');  return; }
        if (e.key === '*')               { handleOp('×');  return; }
        if (e.key === '/') { e.preventDefault(); handleOp('÷'); return; }
        if (e.key === 'Enter' || e.key === '=') { handleEquals(); return; }
        if (e.key === 'Escape')          { overlay.classList.add('hidden'); return; }
        if (e.key === 'Backspace') {
          if (!waitingForNext && display.length > 1) display = display.slice(0, -1);
          else display = '0';
          updateDisplay();
        }
      });
    })();
    </script>
  </body>
</html>
